# Optional local development file. On Vercel, configure process environment variables instead.
# Example secrets below trigger a production warning; use private persistent values there.
NODE_ENV=development
PORT=4001
# Optional comma-separated IP/CIDR allowlist for your reverse proxy; empty trusts no forwarded headers.
TRUSTED_PROXY_CIDRS=
DB_STRING=postgresql://postgres:postgres@localhost:5432/lif
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Local override. When unset, production/Vercel defaults to https://adminonemore.vercel.app.
# On Vercel, explicitly set the deployed admin origin if overriding this default.
ADMIN_WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ROUTING_BASE_URL=https://router.project-osrm.org
PAYMENT_WEBHOOK_SECRET=replace-with-a-webhook-secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAIL_USER=
GOOGLE_APP_PASSWORD=
MAIL_FROM_NAME="1More Partner Program"
# Destination for links in new-user admin emails (one origin, no path).
ADMIN_NOTIFICATION_ORIGIN=https://adminonemore.vercel.app

# Shared SMTP transport (defaults work with a Gmail app password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
