# Optional local development file. On Vercel, configure process environment variables instead.
# Example secrets below trigger a production warning; use private persistent values there.
NODE_ENV=development
PORT=4001
# Optional comma-separated IP/CIDR allowlist for your reverse proxy; empty trusts no forwarded headers.
TRUSTED_PROXY_CIDRS=
DB_STRING=postgresql://postgres:postgres@localhost:5432/lif
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
ADMIN_WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ROUTING_BASE_URL=https://router.project-osrm.org
PAYMENT_WEBHOOK_SECRET=replace-with-a-webhook-secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
