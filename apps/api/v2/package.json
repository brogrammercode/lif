{
  "name": "onemore-api-v2",
  "version": "2.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && prisma db push --skip-generate && nest build",
    "build:compile": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:push": "prisma db push --skip-generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "admin:grant": "tsx src/scripts/grant_admin.ts",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\" \"*.{ts,json}\"",
    "test:unit": "tsc -p tsconfig.test.json && node --require ./dist-tests/src/tests/setup.js --test dist-tests/src/tests/config.test.js dist-tests/src/tests/geocode.test.js dist-tests/src/tests/http.test.js dist-tests/src/tests/media.test.js dist-tests/src/tests/entity_id.test.js dist-tests/src/tests/ride.test.js dist-tests/src/tests/payment.test.js dist-tests/src/tests/auth_identity.test.js dist-tests/src/tests/database.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-tests/src/tests/admin.integration.spec.js dist-tests/src/tests/admin_identity.integration.spec.js",
    "test:identity": "tsc -p tsconfig.test.json && node --test dist-tests/src/tests/admin_identity.integration.spec.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@prisma/client": "^6.19.0",
    "@vercel/functions": "^3.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "prettier": "^3.9.10",
    "prisma": "^6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
