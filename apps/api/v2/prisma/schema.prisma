generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_STRING")
}

enum UserRole {
  RIDER
  DRIVER
  SUPPORT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthProvider {
  GOOGLE
  APPLE
  PHONE
  EMAIL
}

enum DriverAvailability {
  OFFLINE
  AVAILABLE
  EN_ROUTE
  ON_TRIP
  PAUSED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum VehicleType {
  BIKE
  SCOOTER
  AUTO
  SEDAN
  SUV
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  UNDER_REVIEW
  REJECTED
}

enum RideStatus {
  DRAFT
  REQUESTED
  SEARCHING
  DRIVER_ASSIGNED
  DRIVER_ARRIVING
  DRIVER_WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  NO_DRIVER_FOUND
}

enum RideOfferStatus {
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentMethodType {
  CASH
  CARD
  UPI
  WALLET
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum NotificationType {
  RIDE_UPDATE
  PAYMENT_UPDATE
  PROMOTION
  SAFETY
  ACCOUNT
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  EMAIL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model User {
  id                   String     @id @default(uuid())
  role                 UserRole   @default(RIDER)
  status               UserStatus @default(ACTIVE)
  first_name           String?
  last_name            String?
  email                String?    @unique
  phone_e164           String?    @unique
  avatar_url           String?
  last_known_latitude  Decimal?   @db.Decimal(9, 6)
  last_known_longitude Decimal?   @db.Decimal(9, 6)
  deleted_at           DateTime?  @db.Timestamptz(3)
  last_login_at        DateTime?  @db.Timestamptz(3)
  last_admin_login_at  DateTime?  @db.Timestamptz(3)
  created_at           DateTime   @default(now()) @db.Timestamptz(3)
  updated_at           DateTime   @updatedAt @db.Timestamptz(3)

  auth_accounts            AuthAccount[]
  sessions                 Session[]
  devices                  Device[]
  driver_profile           DriverProfile?
  saved_places             SavedPlace[]
  rider_rides              Ride[]              @relation("rider_rides")
  reviews_given            Review[]            @relation("reviews_given")
  reviews_received         Review[]            @relation("reviews_received")
  payment_methods          PaymentMethod[]
  notifications            Notification[]
  support_tickets          SupportTicket[]
  support_messages         SupportMessage[]    @relation("support_message_authors")
  ride_events_as_actor     RideEvent[]         @relation("ride_event_actors")
  audit_logs               UserLog[]           @relation("user_log_actors")
  emergency_contacts       EmergencyContact[]
  idempotency_keys         IdempotencyKey[]
  admin_access             AdminAccess?        @relation("admin_access_user")
  admin_access_grants      AdminAccess[]       @relation("admin_access_granted_by")
  admin_access_revocations AdminAccess[]       @relation("admin_access_revoked_by")
  admin_activity           AdminActivity[]
  brand_requests           VehicleBrand[]      @relation("brand_requester")
  brand_reviews            VehicleBrand[]      @relation("brand_reviewer")
  model_requests           VehicleModel[]      @relation("model_requester")
  model_reviews            VehicleModel[]      @relation("model_reviewer")
  partner_application      PartnerApplication?
  partner_assets           PartnerAsset[]
  partner_activated_at     DateTime?           @db.Timestamptz(3)

  @@index([role, status])
  @@index([created_at])
  @@map("users")
}

model AuthAccount {
  id                  String       @id @default(uuid())
  user_id             String
  provider            AuthProvider
  provider_account_id String
  provider_email      String?
  created_at          DateTime     @default(now()) @db.Timestamptz(3)
  updated_at          DateTime     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@index([user_id])
  @@map("auth_accounts")
}

model Session {
  id                 String    @id @default(uuid())
  user_id            String
  refresh_token_hash String    @unique
  family_id          String?
  user_agent         String?
  ip_address         String?
  expires_at         DateTime  @db.Timestamptz(3)
  revoked_at         DateTime? @db.Timestamptz(3)
  created_at         DateTime  @default(now()) @db.Timestamptz(3)
  updated_at         DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at])
  @@index([family_id, revoked_at])
  @@index([expires_at])
  @@map("sessions")
}

model Device {
  id           String    @id @default(uuid())
  user_id      String
  push_token   String    @unique
  platform     String
  app_version  String?
  last_seen_at DateTime  @default(now()) @db.Timestamptz(3)
  revoked_at   DateTime? @db.Timestamptz(3)
  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  updated_at   DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at])
  @@map("devices")
}

model DriverProfile {
  id                  String             @id @default(uuid())
  user_id             String             @unique
  availability        DriverAvailability @default(OFFLINE)
  verification_status VerificationStatus @default(PENDING)
  license_number      String?            @unique
  rating_average      Decimal            @default(0) @db.Decimal(3, 2)
  ratings_count       Int                @default(0)
  completed_rides     Int                @default(0)
  current_latitude    Decimal?           @db.Decimal(9, 6)
  current_longitude   Decimal?           @db.Decimal(9, 6)
  last_location_at    DateTime?          @db.Timestamptz(3)
  active_vehicle_id   String?            @unique
  verified_at         DateTime?          @db.Timestamptz(3)
  created_at          DateTime           @default(now()) @db.Timestamptz(3)
  updated_at          DateTime           @updatedAt @db.Timestamptz(3)

  user           User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  active_vehicle Vehicle?         @relation("active_vehicle", fields: [active_vehicle_id], references: [id], onDelete: SetNull)
  vehicles       Vehicle[]        @relation("driver_vehicles")
  rides          Ride[]           @relation("driver_rides")
  offers         RideOffer[]      @relation("driver_offers")
  locations      RideLocation[]   @relation("driver_locations")
  documents      DriverDocument[]

  @@index([availability, verification_status])
  @@index([current_latitude, current_longitude])
  @@map("driver_profiles")
}

model DriverDocument {
  id             String             @id @default(uuid())
  driver_id      String
  type           String
  file_url       String
  document_no    String?
  status         VerificationStatus @default(PENDING)
  rejection_note String?
  expires_at     DateTime?          @db.Timestamptz(3)
  reviewed_at    DateTime?          @db.Timestamptz(3)
  created_at     DateTime           @default(now()) @db.Timestamptz(3)
  updated_at     DateTime           @updatedAt @db.Timestamptz(3)

  driver DriverProfile @relation(fields: [driver_id], references: [id], onDelete: Cascade)

  @@index([driver_id, type])
  @@index([status, expires_at])
  @@map("driver_documents")
}

model VehicleCategory {
  id            String      @id @default(uuid())
  code          String      @unique
  name          String
  description   String?
  image_url     String?
  parent_id     String?
  vehicle_type  VehicleType
  capacity      Int         @default(1)
  base_fare     Decimal     @db.Decimal(12, 2)
  per_kilometer Decimal     @db.Decimal(12, 2)
  per_minute    Decimal     @db.Decimal(12, 2)
  is_active     Boolean     @default(true)
  sort_order    Int         @default(0)
  created_at    DateTime    @default(now()) @db.Timestamptz(3)
  updated_at    DateTime    @updatedAt @db.Timestamptz(3)

  parent   VehicleCategory?  @relation("category_hierarchy", fields: [parent_id], references: [id], onDelete: Restrict)
  children VehicleCategory[] @relation("category_hierarchy")
  vehicles Vehicle[]
  quotes   FareQuote[]

  @@index([parent_id, is_active, sort_order])
  @@map("vehicle_categories")
}

model Vehicle {
  id                  String        @id @default(uuid())
  driver_id           String
  type                VehicleType
  status              VehicleStatus @default(UNDER_REVIEW)
  make                String
  model               String
  color               String?
  plate_number        String        @unique
  capacity            Int           @default(1)
  photo_url           String?
  metadata            Json?
  vehicle_category_id String?
  created_at          DateTime      @default(now()) @db.Timestamptz(3)
  updated_at          DateTime      @updatedAt @db.Timestamptz(3)

  driver           DriverProfile    @relation("driver_vehicles", fields: [driver_id], references: [id], onDelete: Cascade)
  active_for       DriverProfile?   @relation("active_vehicle")
  rides            Ride[]           @relation("ride_vehicles")
  vehicle_category VehicleCategory? @relation(fields: [vehicle_category_id], references: [id], onDelete: Restrict)

  @@index([driver_id, status])
  @@index([type, status])
  @@index([vehicle_category_id])
  @@map("vehicles")
}

model SavedPlace {
  id         String   @id @default(uuid())
  user_id    String
  label      String
  address    String
  latitude   Decimal  @db.Decimal(9, 6)
  longitude  Decimal  @db.Decimal(9, 6)
  place_type String   @default("OTHER")
  place_data Json?
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, place_type])
  @@map("saved_places")
}

model Ride {
  id                   String     @id @default(uuid())
  rider_id             String
  driver_id            String?
  vehicle_id           String?
  payment_method_id    String?
  status               RideStatus @default(DRAFT)
  pickup_address       String
  pickup_latitude      Decimal    @db.Decimal(9, 6)
  pickup_longitude     Decimal    @db.Decimal(9, 6)
  dropoff_address      String
  dropoff_latitude     Decimal    @db.Decimal(9, 6)
  dropoff_longitude    Decimal    @db.Decimal(9, 6)
  requested_at         DateTime?  @db.Timestamptz(3)
  matched_at           DateTime?  @db.Timestamptz(3)
  arrived_at           DateTime?  @db.Timestamptz(3)
  started_at           DateTime?  @db.Timestamptz(3)
  completed_at         DateTime?  @db.Timestamptz(3)
  cancelled_at         DateTime?  @db.Timestamptz(3)
  cancel_reason        String?
  rider_note           String?
  access_code          String?
  estimated_distance_m Int?
  estimated_duration_s Int?
  actual_distance_m    Int?
  actual_duration_s    Int?
  estimated_fare       Decimal?   @db.Decimal(12, 2)
  final_fare           Decimal?   @db.Decimal(12, 2)
  currency             String     @default("INR") @db.VarChar(3)
  created_at           DateTime   @default(now()) @db.Timestamptz(3)
  updated_at           DateTime   @updatedAt @db.Timestamptz(3)

  rider           User            @relation("rider_rides", fields: [rider_id], references: [id], onDelete: Restrict)
  driver          DriverProfile?  @relation("driver_rides", fields: [driver_id], references: [id], onDelete: SetNull)
  vehicle         Vehicle?        @relation("ride_vehicles", fields: [vehicle_id], references: [id], onDelete: SetNull)
  payment_method  PaymentMethod?  @relation(fields: [payment_method_id], references: [id], onDelete: SetNull)
  quotes          FareQuote[]
  offers          RideOffer[]
  route           RideRoute?
  locations       RideLocation[]
  events          RideEvent[]
  payment         Payment?
  reviews         Review[]
  support_tickets SupportTicket[]

  @@index([rider_id, created_at])
  @@index([driver_id, status, created_at])
  @@index([status, requested_at])
  @@map("rides")
}

model FareQuote {
  id                  String      @id @default(uuid())
  ride_id             String
  vehicle_type        VehicleType
  distance_m          Int
  duration_s          Int
  pickup_eta_s        Int?
  base_fare           Decimal     @db.Decimal(12, 2)
  distance_fare       Decimal     @db.Decimal(12, 2)
  time_fare           Decimal     @db.Decimal(12, 2)
  surge_multiplier    Decimal     @default(1) @db.Decimal(5, 2)
  total_fare          Decimal     @db.Decimal(12, 2)
  currency            String      @default("INR") @db.VarChar(3)
  expires_at          DateTime    @db.Timestamptz(3)
  selected_at         DateTime?   @db.Timestamptz(3)
  vehicle_category_id String?
  category_snapshot   Json?
  created_at          DateTime    @default(now()) @db.Timestamptz(3)
  updated_at          DateTime    @updatedAt @db.Timestamptz(3)

  ride             Ride             @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  vehicle_category VehicleCategory? @relation(fields: [vehicle_category_id], references: [id], onDelete: Restrict)

  @@index([ride_id, expires_at])
  @@index([vehicle_category_id])
  @@map("fare_quotes")
}

model RideOffer {
  id           String          @id @default(uuid())
  ride_id      String
  driver_id    String
  status       RideOfferStatus @default(SENT)
  sent_at      DateTime        @default(now()) @db.Timestamptz(3)
  responded_at DateTime?       @db.Timestamptz(3)
  expires_at   DateTime        @db.Timestamptz(3)
  created_at   DateTime        @default(now()) @db.Timestamptz(3)
  updated_at   DateTime        @updatedAt @db.Timestamptz(3)

  ride   Ride          @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  driver DriverProfile @relation("driver_offers", fields: [driver_id], references: [id], onDelete: Restrict)

  @@unique([ride_id, driver_id])
  @@index([driver_id, status, expires_at])
  @@map("ride_offers")
}

model RideRoute {
  id               String   @id @default(uuid())
  ride_id          String   @unique
  provider         String
  encoded_polyline String?
  route_data       Json?
  distance_m       Int
  duration_s       Int
  created_at       DateTime @default(now()) @db.Timestamptz(3)
  updated_at       DateTime @updatedAt @db.Timestamptz(3)

  ride Ride @relation(fields: [ride_id], references: [id], onDelete: Cascade)

  @@map("ride_routes")
}

model RideLocation {
  id          String   @id @default(uuid())
  ride_id     String
  driver_id   String?
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  heading     Decimal? @db.Decimal(6, 2)
  speed_kph   Decimal? @db.Decimal(7, 2)
  recorded_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  ride   Ride           @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  driver DriverProfile? @relation("driver_locations", fields: [driver_id], references: [id], onDelete: SetNull)

  @@index([ride_id, recorded_at])
  @@index([driver_id, recorded_at])
  @@map("ride_locations")
}

model RideEvent {
  id         String   @id @default(uuid())
  ride_id    String
  actor_id   String?
  event_type String
  metadata   Json?
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  ride  Ride  @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  actor User? @relation("ride_event_actors", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([ride_id, created_at])
  @@map("ride_events")
}

model PaymentMethod {
  id                   String            @id @default(uuid())
  user_id              String
  type                 PaymentMethodType
  provider             String?
  provider_customer_id String?
  provider_method_id   String?
  card_brand           String?
  card_last4           String?
  upi_handle           String?
  is_default           Boolean           @default(false)
  created_at           DateTime          @default(now()) @db.Timestamptz(3)
  updated_at           DateTime          @updatedAt @db.Timestamptz(3)

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  rides    Ride[]
  payments Payment[]

  @@index([user_id, is_default])
  @@map("payment_methods")
}

model Payment {
  id                  String        @id @default(uuid())
  ride_id             String        @unique
  payment_method_id   String?
  status              PaymentStatus @default(PENDING)
  provider            String?
  provider_payment_id String?       @unique
  amount              Decimal       @db.Decimal(12, 2)
  currency            String        @default("INR") @db.VarChar(3)
  paid_at             DateTime?     @db.Timestamptz(3)
  failed_at           DateTime?     @db.Timestamptz(3)
  refunded_at         DateTime?     @db.Timestamptz(3)
  created_at          DateTime      @default(now()) @db.Timestamptz(3)
  updated_at          DateTime      @updatedAt @db.Timestamptz(3)

  ride           Ride           @relation(fields: [ride_id], references: [id], onDelete: Restrict)
  payment_method PaymentMethod? @relation(fields: [payment_method_id], references: [id], onDelete: SetNull)

  @@index([status, created_at])
  @@map("payments")
}

model Review {
  id          String   @id @default(uuid())
  ride_id     String
  reviewer_id String
  reviewee_id String
  score       Int
  comment     String?
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  ride     Ride @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  reviewer User @relation("reviews_given", fields: [reviewer_id], references: [id], onDelete: Restrict)
  reviewee User @relation("reviews_received", fields: [reviewee_id], references: [id], onDelete: Restrict)

  @@unique([ride_id, reviewer_id, reviewee_id])
  @@index([reviewee_id, created_at])
  @@map("reviews")
}

model Notification {
  id         String              @id @default(uuid())
  user_id    String
  type       NotificationType
  channel    NotificationChannel @default(IN_APP)
  title      String
  body       String
  data       Json?
  read_at    DateTime?           @db.Timestamptz(3)
  sent_at    DateTime?           @db.Timestamptz(3)
  created_at DateTime            @default(now()) @db.Timestamptz(3)
  updated_at DateTime            @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, read_at, created_at])
  @@map("notifications")
}

model SupportTicket {
  id          String         @id @default(uuid())
  user_id     String
  ride_id     String?
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  subject     String
  created_at  DateTime       @default(now()) @db.Timestamptz(3)
  updated_at  DateTime       @updatedAt @db.Timestamptz(3)
  resolved_at DateTime?      @db.Timestamptz(3)

  user     User             @relation(fields: [user_id], references: [id], onDelete: Restrict)
  ride     Ride?            @relation(fields: [ride_id], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([user_id, status, created_at])
  @@index([ride_id])
  @@map("support_tickets")
}

model SupportMessage {
  id          String   @id @default(uuid())
  ticket_id   String
  author_id   String?
  body        String
  attachments Json?
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  author User?         @relation("support_message_authors", fields: [author_id], references: [id], onDelete: SetNull)

  @@index([ticket_id, created_at])
  @@map("support_messages")
}

model UserLog {
  id          String   @id @default(uuid())
  actor_id    String?
  entity_type String
  entity_id   String
  action      String
  before_data Json?
  after_data  Json?
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  actor User? @relation("user_log_actors", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([entity_type, entity_id, created_at])
  @@index([actor_id, created_at])
  @@map("user_logs")
}

model EmergencyContact {
  id           String   @id @default(uuid())
  user_id      String
  name         String
  phone_e164   String
  relationship String?
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  updated_at   DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("emergency_contacts")
}

model IdempotencyKey {
  id            String   @id @default(uuid())
  user_id       String?
  scope         String
  key           String
  request_hash  String
  response_json Json?
  status_code   Int?
  expires_at    DateTime @db.Timestamptz(3)
  created_at    DateTime @default(now()) @db.Timestamptz(3)
  updated_at    DateTime @updatedAt @db.Timestamptz(3)

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([scope, key])
  @@index([user_id, expires_at])
  @@index([expires_at])
  @@map("idempotency_keys")
}

model AdminAccess {
  id            String    @id @default(uuid())
  user_id       String    @unique
  previous_role UserRole
  granted_by_id String?
  granted_at    DateTime  @default(now()) @db.Timestamptz(3)
  revoked_by_id String?
  revoked_at    DateTime? @db.Timestamptz(3)
  created_at    DateTime  @default(now()) @db.Timestamptz(3)
  updated_at    DateTime  @updatedAt @db.Timestamptz(3)

  user       User  @relation("admin_access_user", fields: [user_id], references: [id], onDelete: Cascade)
  granted_by User? @relation("admin_access_granted_by", fields: [granted_by_id], references: [id], onDelete: SetNull)
  revoked_by User? @relation("admin_access_revoked_by", fields: [revoked_by_id], references: [id], onDelete: SetNull)

  @@index([granted_by_id])
  @@index([revoked_by_id])
  @@map("admin_access")
}

enum CatalogStatus {
  REQUESTED
  VERIFIED
  REJECTED
}

enum RequirementFieldType {
  STRING
  TEXT
  NUMBER
  DATE
  BOOLEAN
  FILE
  IMAGE
  PDF
}

model AdminActivity {
  id           String    @id @default(uuid())
  request_id   String    @unique
  actor_id     String?
  method       String
  path         String
  action       String
  status_code  Int?
  ip_address   String?
  user_agent   String?
  started_at   DateTime  @default(now()) @db.Timestamptz(3)
  completed_at DateTime? @db.Timestamptz(3)
  actor        User?     @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([actor_id, started_at])
  @@index([started_at])
  @@map("admin_activity")
}

model VehicleBrand {
  id               String         @id @default(uuid())
  name             String
  normalized_name  String         @unique
  description      String?
  country          String?
  website_url      String?
  logo_url         String?
  status           CatalogStatus  @default(VERIFIED)
  is_active        Boolean        @default(true)
  requested_by_id  String?
  reviewed_by_id   String?
  reviewed_at      DateTime?      @db.Timestamptz(3)
  rejection_reason String?
  created_at       DateTime       @default(now()) @db.Timestamptz(3)
  updated_at       DateTime       @updatedAt @db.Timestamptz(3)
  requested_by     User?          @relation("brand_requester", fields: [requested_by_id], references: [id], onDelete: SetNull)
  reviewed_by      User?          @relation("brand_reviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  models           VehicleModel[]

  @@index([status, is_active])
  @@map("vehicle_brands")
}

model VehicleModel {
  id               String        @id @default(uuid())
  brand_id         String
  name             String
  normalized_name  String
  description      String?
  vehicle_type     VehicleType
  fuel_type        String
  seating_capacity Int
  year_from        Int?
  year_to          Int?
  logo_url         String?
  status           CatalogStatus @default(VERIFIED)
  is_active        Boolean       @default(true)
  requested_by_id  String?
  reviewed_by_id   String?
  reviewed_at      DateTime?     @db.Timestamptz(3)
  rejection_reason String?
  created_at       DateTime      @default(now()) @db.Timestamptz(3)
  updated_at       DateTime      @updatedAt @db.Timestamptz(3)
  brand            VehicleBrand  @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  requested_by     User?         @relation("model_requester", fields: [requested_by_id], references: [id], onDelete: SetNull)
  reviewed_by      User?         @relation("model_reviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull)

  @@unique([brand_id, normalized_name])
  @@index([brand_id, status, is_active])
  @@map("vehicle_models")
}

model RequirementCategory {
  id              String               @id @default(uuid())
  name            String
  normalized_name String               @unique
  description     String?
  sort_order      Int                  @default(0)
  is_active       Boolean              @default(true)
  created_at      DateTime             @default(now()) @db.Timestamptz(3)
  updated_at      DateTime             @updatedAt @db.Timestamptz(3)
  fields          PartnerRequirement[]

  @@map("requirement_categories")
}

model PartnerRequirement {
  id                 String               @id @default(uuid())
  category_id        String
  key                String               @unique
  label              String
  field_type         RequirementFieldType
  description        String?
  placeholder        String?
  is_required        Boolean              @default(true)
  is_active          Boolean              @default(true)
  sort_order         Int                  @default(0)
  min_value          Float?
  max_value          Float?
  max_length         Int?
  max_file_size_mb   Int?
  allowed_extensions String[]             @default([])
  allow_multiple     Boolean              @default(false)
  created_at         DateTime             @default(now()) @db.Timestamptz(3)
  updated_at         DateTime             @updatedAt @db.Timestamptz(3)
  category           RequirementCategory  @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@index([category_id, is_active, sort_order])
  @@map("partner_requirements")
}

enum PartnerApplicationStatus {
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  CONFIRMATION_SUBMITTED
  CONFIRMATION_CHANGES_REQUESTED
  COMPLETED
  ACTIVATED
}

enum PartnerReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model PartnerDocument {
  id                String    @id @default(uuid())
  kind              String    @unique
  title             String
  html              String
  revision          Int       @default(1)
  published_title   String?
  published_html    String?
  published_version Int       @default(0)
  published_at      DateTime? @db.Timestamptz(3)
  created_at        DateTime  @default(now()) @db.Timestamptz(3)
  updated_at        DateTime  @updatedAt @db.Timestamptz(3)

  @@map("partner_documents")
}

model PartnerApplication {
  id                    String                    @id @default(uuid())
  user_id               String                    @unique
  status                PartnerApplicationStatus  @default(SUBMITTED)
  version               Int                       @default(1)
  contact_email         String
  whatsapp_phone        String
  policy_snapshot       Json
  confirmation_document Json?
  submitted_at          DateTime                  @default(now()) @db.Timestamptz(3)
  reviewed_at           DateTime?                 @db.Timestamptz(3)
  reviewed_by_id        String?
  completed_at          DateTime?                 @db.Timestamptz(3)
  activated_at          DateTime?                 @db.Timestamptz(3)
  final_pdf_id          String?
  activation_hash       String?
  activation_salt       String?
  activation_ciphertext String?
  activation_attempts   Int                       @default(0)
  activation_issued_at  DateTime?                 @db.Timestamptz(3)
  created_at            DateTime                  @default(now()) @db.Timestamptz(3)
  updated_at            DateTime                  @updatedAt @db.Timestamptz(3)
  user                  User                      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  fields                PartnerApplicationField[]
  confirmation          PartnerConfirmation?
  deliveries            PartnerDelivery[]

  @@index([status, submitted_at])
  @@map("partner_applications")
}

model PartnerApplicationField {
  id               String              @id @default(uuid())
  application_id   String
  requirement_id   String
  definition       Json
  value            Json
  status           PartnerReviewStatus @default(PENDING)
  rejection_reason String?
  reviewed_by_id   String?
  reviewed_at      DateTime?           @db.Timestamptz(3)
  created_at       DateTime            @default(now()) @db.Timestamptz(3)
  updated_at       DateTime            @updatedAt @db.Timestamptz(3)
  application      PartnerApplication  @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@unique([application_id, requirement_id])
  @@map("partner_application_fields")
}

model PartnerConfirmation {
  id                String              @id @default(uuid())
  application_id    String              @unique
  document_snapshot Json
  signature_name    String
  accepted_at       DateTime            @default(now()) @db.Timestamptz(3)
  status            PartnerReviewStatus @default(PENDING)
  rejection_reason  String?
  reviewed_by_id    String?
  reviewed_at       DateTime?           @db.Timestamptz(3)
  created_at        DateTime            @default(now()) @db.Timestamptz(3)
  updated_at        DateTime            @updatedAt @db.Timestamptz(3)
  application       PartnerApplication  @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@map("partner_confirmations")
}

model PartnerAsset {
  id         String   @id @default(uuid())
  owner_id   String
  purpose    String
  field_id   String?
  file_name  String
  mime_type  String
  size       Int
  sha256     String
  content    Bytes
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)
  owner      User     @relation(fields: [owner_id], references: [id], onDelete: Restrict)

  @@index([owner_id, purpose])
  @@map("partner_assets")
}

model PartnerDelivery {
  id             String             @id @default(uuid())
  application_id String
  channel        String
  status         String             @default("PENDING")
  attempts       Int                @default(0)
  last_error     String?
  sent_at        DateTime?          @db.Timestamptz(3)
  claimed_at     DateTime?          @db.Timestamptz(3)
  provider_id    String?
  created_at     DateTime           @default(now()) @db.Timestamptz(3)
  updated_at     DateTime           @updatedAt @db.Timestamptz(3)
  application    PartnerApplication @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@unique([application_id, channel])
  @@index([status, updated_at])
  @@map("partner_deliveries")
}
